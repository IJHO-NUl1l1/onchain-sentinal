# .env.example — 이 파일만 커밋한다. 실제 값이 든 .env 는 절대 커밋 금지.
#
# ⚠️ 8/9부터: 이 레포는 .env 파일이 두 곳이다. 이 파일은 전체를 한눈에 보는 참고용 템플릿이고,
# 실제로는 아래처럼 나눠서 채운다 — Next.js/Hardhat이 각자 자기 프로젝트 기준으로만 .env를 읽어서다:
#   - 🔵 KeeperHub / 🟢 공유 섹션 → cp .env.example app/.env      (Windows: copy .env.example app\.env)
#   - 🟠 Flare 섹션               → cp contracts/.env.example contracts/.env (변수가 더 적은 전용 템플릿)
# 두 번째 기기에는 이 템플릿들만 git으로 오고, 실제 키값은 안전한 경로로 직접 옮겨라.
# 키값을 커밋·이슈·채팅에 붙여넣지 마라.

# ─────────────────────────────────────────────
# 🔵 KeeperHub
# ─────────────────────────────────────────────
# 조직 키 (REST / MCP 용). 접두사 kh_
KEEPERHUB_API_KEY=
# 유저 키 (웹훅 트리거 용). 접두사 wfb_
KEEPERHUB_WEBHOOK_KEY=

# 개발용 체인 (문자열 chainId 로 넘겨야 한다 — 숫자 아님)
#   Sepolia=11155111 / Base Sepolia=84532 / mainnet=1 / Base=8453
KEEPERHUB_DEV_CHAIN_ID=11155111

# ─────────────────────────────────────────────
# 🟠 Flare (Coston2)
# ─────────────────────────────────────────────
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_CHAIN_ID=114
COSTON2_EXPLORER_URL=https://coston2-explorer.flare.network

# 컨트랙트 배포/실행용 키. 0x 포함. 테스트넷 전용 키만 쓸 것.
DEPLOYER_PRIVATE_KEY=

# 배포 후 채운다 (제출물 "smart contract address"). 8/9 배포 완료 — 실제 값 기본으로 채워둠
# (공개 테스트넷 컨트랙트 주소라 비밀 아님. architecture.md §3에도 기록됨)
SENTINEL_VAULT_ADDRESS=0xBf5778109e894b7C093D91B8a7518c95Fe74c3EF

# FDC (스코프 밸브 — 안 쓰면 비워둬도 된다)
VERIFIER_URL_TESTNET=
VERIFIER_API_KEY_TESTNET=
COSTON2_DA_LAYER_URL=

# ─────────────────────────────────────────────
# 🟢 공유 백엔드
# ─────────────────────────────────────────────
# Supabase (판단 로그 저장)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 감시 대상 지갑 (주소 문자열만. 지갑 연동 없음)
DEMO_WATCH_ADDRESS=
